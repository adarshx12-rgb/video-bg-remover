# Dev only: serve the compressed withoutBG files from model-files/ (see astro.config.mjs).
# For production, set PUBLIC_MODEL_MIRROR in the host's build settings to where the files
# are uploaded (for example a Hugging Face repo's .../resolve/main/ URL), or leave it
# unset to use the publisher's full-size file.
PUBLIC_MODEL_MIRROR=/model-files/
